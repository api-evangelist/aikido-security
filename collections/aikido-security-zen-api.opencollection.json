{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aikido Security Public REST Clouds Zen API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Zen",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Zen apps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.aikido.dev/api/public/v1/zen/apps"
          },
          "docs": "List Zen apps"
        },
        {
          "info": {
            "name": "Create Zen app",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.aikido.dev/api/public/v1/zen/apps"
          },
          "docs": "Create Zen app"
        },
        {
          "info": {
            "name": "Get Zen app",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.aikido.dev/api/public/v1/zen/apps/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Zen app"
        },
        {
          "info": {
            "name": "Delete Zen app",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.aikido.dev/api/public/v1/zen/apps/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Zen app"
        }
      ]
    }
  ],
  "bundled": true
}